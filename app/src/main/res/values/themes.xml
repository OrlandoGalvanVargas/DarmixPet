<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DarmixPet" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.DarmixPet.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FAF6F0</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_empty</item>
        <item name="windowSplashScreenAnimationDuration">200</item>
        <item name="postSplashScreenTheme">@style/Theme.DarmixPet</item>
    </style>
</resources>
